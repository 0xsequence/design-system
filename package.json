{
  "name": "@0xsequence/design-system",
  "version": "4.0.0-alpha.18",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "style": "dist/index.css",
  "types": "dist/index.d.ts",
  "homepage": "https://0xsequence.github.io/design-system/",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./index.css": "./dist/index.css",
    "./preset": "./dist/index.css"
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "pnpm storybook",
    "build": "tsup",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o ./docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx}'",
    "prettier": "prettier --list-different --write \"src/**/*.{ts,tsx}\"",
    "prettier:fix": "prettier --list-different --write \"src/**/*.{ts,tsx}\"",
    "format": "pnpm run lint:fix && pnpm run prettier:fix",
    "prepare": "husky",
    "prepack": "pnpm build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && pnpm test && changeset publish",
    "attw": "attw --pack .",
    "knip": "knip"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react-day-picker": "^9.14.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-designs": "11.1.3",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.3.5",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "knip": "6.7.0",
    "lucide-react": "^1.12.0",
    "ox": "0.13.1",
    "prettier": "3.8.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "storybook": "10.3.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-eslint": "1.8.1",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "lucide-react": ">= 1.7.0",
    "react": ">= 17",
    "react-dom": ">= 17"
  },
  "packageManager": "pnpm@10.30.1"
}
